PORT=8000
CORS_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://bmf:bmf_password@localhost:5432/bring_me_food
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=bring-me-food
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_URL=http://localhost:9000/bring-me-food
FINAL_PREFIX=uploads/final
TMP_PREFIX=uploads/tmp
JWT_SECRET=your-random-secret-here-at-least-32-characters

# Email distribution (Resend — free tier: 3000 emails/month)
# Get your key at https://resend.com
RESEND_API_KEY=re_your_key_here

# Public base URL (used in email links)
APP_BASE_URL=http://localhost:3000

# Email sender addresses (must be from a verified Resend domain)
# Use onboarding@resend.dev for testing (only delivers to your own account)
EMAIL_FROM_MENU=menu@yourdomain.com
EMAIL_FROM_ORDERS=orders@yourdomain.com

# Admin notification email — when a new chef signs up, this address is notified
ADMIN_NOTIFICATION_EMAIL=fmarostega@gmail.com
