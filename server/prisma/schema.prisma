model Meal {
  id            String          @id @default(uuid()) @db.VarChar(50)
  name          String          @db.VarChar(150)
  description   String          @db.VarChar(250)
  price         Float //https://www.prisma.io/docs/orm/prisma-client/special-fields-and-types
  size          Int?
  image         String?         @db.VarChar(150)
  ingredients   String[]
  allergens     String[]
  /// Optional: max portions available per week/session; null = unlimited
  stockLimit    Int?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  chefId        String          @db.VarChar(50)
  chef          Chef            @relation(fields: [chefId], references: [id])
  mealsOnOrders MealsOnOrders[]
  menus         Menu[]          @relation("menu_meal")
}

//https://www.prisma.io/docs/orm/prisma-schema/data-model/relations/many-to-many-relations
model MealsOnOrders {
  id             String @id @default(uuid()) @db.VarChar(50)
  mealId         String @db.VarChar(50)
  meal           Meal   @relation(fields: [mealId], references: [id])
  orderId        String @db.VarChar(50)
  order          Order  @relation(fields: [orderId], references: [id])
  quantity       Int    @default(1)
  priceAtPurchase Float
}

model Order {
  id                    String          @id @default(uuid()) @db.VarChar(50)
  status                OrderStatus     @default(PENDING)
  paymentStatus         PaymentStatus   @default(PENDING)
  total                 Float
  deliveryFee           Float           @default(0)
  deliveryAddress       String          @db.VarChar(250)
  notes                 String?         @db.VarChar(300)
  // Guest checkout fields (set when customerId is null)
  guestName             String?         @db.VarChar(150)
  guestPhone            String?         @db.VarChar(20)
  guestEmail            String?         @db.VarChar(150)
  // Delivery zone tracking
  deliverySuburb        String?         @db.VarChar(100)
  outsideZone           Boolean         @default(false)
  // Promo code
  promoCode             String?         @db.VarChar(50)
  discountAmount        Float?
  // Stripe payment fields
  stripeSessionId       String?         @db.VarChar(200)
  stripePaymentIntentId String?         @db.VarChar(200)
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  chefId                String          @db.VarChar(50)
  chef                  Chef            @relation(fields: [chefId], references: [id])
  customerId            String?         @db.VarChar(50)
  customer              Customer?       @relation(fields: [customerId], references: [id])
  mealsOnOrders         MealsOnOrders[]
}

enum UserStatus {
  CREATED
  PENDING
  ACTIVE
  INACTIVE
  BLOCKED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
  FAILED
}

model PromoCode {
  id            String    @id @default(uuid()) @db.VarChar(50)
  code          String    @db.VarChar(50)
  chefId        String    @db.VarChar(50)
  chef          Chef      @relation(fields: [chefId], references: [id])
  /// PERCENTAGE (0-100) or FIXED (dollar amount)
  discountType  DiscountType @default(PERCENTAGE)
  discountValue Float        // e.g. 20 = 20% off, or 5 = $5 off
  /// Optional usage cap. Null = unlimited.
  maxUses       Int?
  usedCount     Int       @default(0)
  /// Optional expiry. Null = never expires.
  expiresAt     DateTime?
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([code, chefId])
  @@index([chefId])
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

model Subscriber {
  id           String    @id @default(uuid()) @db.VarChar(50)
  email        String    @db.VarChar(150)
  name         String?   @db.VarChar(150)
  /// Optional: subscriber's phone number for SMS menu distribution (E.164 format, e.g. +61412345678)
  phone        String?   @db.VarChar(20)
  /// Whether SMS has been opted out (separate from email unsubscribe)
  smsOptedOut  Boolean   @default(false)
  chefId       String    @db.VarChar(50)
  chef         Chef      @relation(fields: [chefId], references: [id])
  unsubscribed Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([email, chefId])
  @@index([chefId])
}
