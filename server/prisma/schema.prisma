generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String     @id @default(uuid()) @db.VarChar(50)
  email          String     @unique @db.VarChar(150)
  username       String?    @unique @db.VarChar(100)
  passwordHash   String?    @db.VarChar(255) // bcrypt hash, null for legacy/seed users
  cognitoId      String?    @db.VarChar(150)
  status         UserStatus @default(CREATED)
  emailVerified  Boolean    @default(false) // True after user verifies email in Cognito
  deletedAt      DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  resetToken       String?   @db.VarChar(64)
  resetTokenExpiry DateTime?
  isAdmin          Boolean   @default(false)
  chef           Chef?
  customer       Customer?

  @@unique([cognitoId], map: "User_cognitoId_key") // Unique constraint only for non-null values
  @@index([email])
  @@index([username])
  @@index([cognitoId])
}

model Customer {
  id          String    @id @default(uuid()) @db.VarChar(50)
  firstName   String    @db.VarChar(150)
  middleName  String?   @db.VarChar(150)
  lastName    String    @db.VarChar(150)
  phoneNumber String    @db.VarChar(20)
  address     String    @db.VarChar(250)
  city        String    @db.VarChar(100)
  state       String    @db.VarChar(10)
  country     String    @db.VarChar(3)
  postalCode  String    @db.VarChar(10)
  company     String?   @db.VarChar(150)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  userId      String    @unique @db.VarChar(50)
  user        User      @relation(fields: [userId], references: [id])
  order       Order[]
}

model Chef {
  id           String    @id @default(uuid()) @db.VarChar(50)
  username     String    @unique @db.VarChar(200)
  name         String    @db.VarChar(200)
  location     String    @db.VarChar(150)
  bio          String?
  specialties  String?   @db.VarChar(250)
  phoneNumber  String?   @db.VarChar(20)
  profileImage String?   @db.VarChar(500)
  // Delivery zones
  featured       Boolean   @default(false)  // Admin can feature chefs on search page
  deliveryMode   String    @default("ALL")  // "ALL" | "ZONES"
  deliveryZones  String[]  @default([])     // specific suburbs allowed
  deliveryCities String[]  @default([])     // all suburbs in these cities allowed
  deletedAt    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  userId      String       @unique @db.VarChar(50)
  user        User         @relation(fields: [userId], references: [id])
  meals       Meal[]
  menus       Menu[]
  order       Order[]
  subscribers Subscriber[]
  promoCodes  PromoCode[]

  @@index([username])
}

model Menu {
  id          String    @id @default(uuid()) @db.VarChar(50)
  name        String    @db.VarChar(100)
  description String    @db.VarChar(250)
  startDate   DateTime
  endDate     DateTime
  orderFrom      DateTime?
  orderTo        DateTime?
  distributedAt  DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  chefId         String    @db.VarChar(50)
  chef           Chef      @relation(fields: [chefId], references: [id])
  meals          Meal[]    @relation("menu_meal")
}

